2026-10-13T07:31:57.4797321Z [36;1mimport json, os, subprocess, sys[0m
2026-10-13T07:31:57.4797669Z [36;1mstate = json.load(open(sys.argv[1], encoding="utf-8"))[0m
2026-10-13T07:31:57.4798040Z [36;1mtodo = list(state.get("tokens", {}).items())[0m
2026-10-13T07:31:57.4798471Z [36;1mif state.get("revoked_token") and not state.get("revoked_before_programs"):[0m
2026-10-13T07:31:57.4798956Z [36;1m    todo.append(("the revoked token", state["revoked_token"]))[0m
2026-10-13T07:31:57.4799327Z [36;1melif state.get("revoked_token"):[0m
2026-10-13T07:31:57.4799685Z [36;1m    print("revoked token: already revoked before the programs")[0m
2026-10-13T07:31:57.4800033Z [36;1mbad = 0[0m
2026-10-13T07:31:57.4800246Z [36;1mfor role_class, token in todo:[0m
2026-10-13T07:31:57.4800656Z [36;1m    r = subprocess.run(["psql", "-X", "-q", "-A", "-t", "-v", "ON_ERROR_STOP=1", "-f", "-"],[0m
2026-10-13T07:31:57.4801249Z [36;1m                       input="\\getenv tok W03_TOKEN\nselect devos_private.revoke_env_token(:'tok');\n",[0m
2026-10-13T07:31:57.4802138Z [36;1m                       capture_output=True, text=True, env={**os.environ, "W03_TOKEN": token})[0m
2026-10-13T07:31:57.4802751Z [36;1m    print(f"synthetic token for {role_class}: {'revoked' if r.returncode == 0 else 'NOT revoked'}")[0m
2026-10-13T07:31:57.4803229Z [36;1m    bad += r.returncode != 0[0m
2026-10-13T07:31:57.4803509Z [36;1mraise SystemExit(1 if bad else 0)[0m
2026-10-13T07:31:57.4803775Z [36;1mPY[0m
2026-10-13T07:31:57.4803965Z [36;1mrm -f "$f"[0m
2026-10-13T07:31:57.4804167Z [36;1mexit $rc[0m
