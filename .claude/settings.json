{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/tool_allowlist.py\"; rc=$?; [ $rc -eq 0 ] || exit 2"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__claude-code-remote__create_session|mcp__claude-code-remote__create_trigger",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/record_owned_id.py\" || true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "t=$(date -u +%Y-%m-%dT%H:%M:%SZ); echo \"$t\" > /tmp/devos_probe_sessionstart; echo \"PROBE-SS-MARKER-W12 SessionStart hook ran at $t\""
          }
        ]
      }
    ]
  }
}
