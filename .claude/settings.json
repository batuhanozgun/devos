{
  "model": "claude-opus-5-5",
  "effortLevel": "xhigh",
  "ultracode": true,
  "env": {
    "ECC_HOOKS_ENABLED": "false"
  },
  "enabledPlugins": {
    "ecc@synced": false
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "RemoteTrigger",
      "ListAgents",
      "mcp__claude-code-remote__archive_session",
      "mcp__claude-code-remote__check_repo_access",
      "mcp__claude-code-remote__create_session",
      "mcp__claude-code-remote__create_trigger",
      "mcp__claude-code-remote__delete_trigger",
      "mcp__claude-code-remote__fire_trigger",
      "mcp__claude-code-remote__get_event",
      "mcp__claude-code-remote__get_trigger",
      "mcp__claude-code-remote__interrupt_session",
      "mcp__claude-code-remote__list_environments",
      "mcp__claude-code-remote__list_events",
      "mcp__claude-code-remote__list_repos",
      "mcp__claude-code-remote__list_sessions",
      "mcp__claude-code-remote__list_triggers",
      "mcp__claude-code-remote__register_repo_root",
      "mcp__claude-code-remote__send_message",
      "mcp__claude-code-remote__set_session_tags",
      "mcp__claude-code-remote__set_session_title",
      "mcp__claude-code-remote__subscribe_pr_activity",
      "mcp__claude-code-remote__unarchive_session",
      "mcp__claude-code-remote__unsubscribe_pr_activity",
      "mcp__claude-code-remote__unwatch_url",
      "mcp__claude-code-remote__update_trigger",
      "mcp__claude-code-remote__watch_url",
      "mcp__Claude_Code_Remote__archive_session",
      "mcp__Claude_Code_Remote__check_repo_access",
      "mcp__Claude_Code_Remote__create_session",
      "mcp__Claude_Code_Remote__create_trigger",
      "mcp__Claude_Code_Remote__delete_trigger",
      "mcp__Claude_Code_Remote__fire_trigger",
      "mcp__Claude_Code_Remote__get_event",
      "mcp__Claude_Code_Remote__get_trigger",
      "mcp__Claude_Code_Remote__interrupt_session",
      "mcp__Claude_Code_Remote__list_environments",
      "mcp__Claude_Code_Remote__list_events",
      "mcp__Claude_Code_Remote__list_repos",
      "mcp__Claude_Code_Remote__list_sessions",
      "mcp__Claude_Code_Remote__list_triggers",
      "mcp__Claude_Code_Remote__register_repo_root",
      "mcp__Claude_Code_Remote__send_message",
      "mcp__Claude_Code_Remote__set_session_tags",
      "mcp__Claude_Code_Remote__set_session_title",
      "mcp__Claude_Code_Remote__subscribe_pr_activity",
      "mcp__Claude_Code_Remote__unarchive_session",
      "mcp__Claude_Code_Remote__unsubscribe_pr_activity",
      "mcp__Claude_Code_Remote__unwatch_url",
      "mcp__Claude_Code_Remote__update_trigger",
      "mcp__Claude_Code_Remote__watch_url",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__archive_session",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__check_repo_access",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__create_session",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__create_trigger",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__delete_trigger",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__fire_trigger",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__get_event",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__get_trigger",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__interrupt_session",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__list_environments",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__list_events",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__list_repos",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__list_sessions",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__list_triggers",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__register_repo_root",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__send_message",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__set_session_tags",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__set_session_title",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__subscribe_pr_activity",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__unarchive_session",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__unsubscribe_pr_activity",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__unwatch_url",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__update_trigger",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__watch_url",
      "mcp__ccd_session"
    ]
  },
  "crossSessionInbound": "refuse",
  "isolatePeerMachines": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "out=$(python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/tool_allowlist.py\"); rc=$?; case \"$rc:$out\" in '0:{\"hookSpecificOutput\": {\"hookEventName\": \"PreToolUse\", \"permissionDecision\": \"'*'}}'|'0:DevOS guard: pass, no decision: the user answers this tool (N-185)') printf '%s\\n' \"$out\" ;; *) printf '%s\\n' 'DevOS guard: DENIED, failing closed: the guard could not decide this call (it did not run, it failed, it printed nothing, or its answer was not a PreToolUse decision). What to do instead: do not pursue the effect another way; record the denial and report the guard fault (plan/Installation_Working_Order.md section 10).' >&2; exit 2 ;; esac",
            "timeout": 600,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "out=$(python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/tool_allowlist.py\" PermissionRequest); rc=$?; case \"$rc:$out\" in '0:{\"hookSpecificOutput\": {\"hookEventName\": \"PermissionRequest\", \"decision\": {\"behavior\": \"'*'}}}'|'0:DevOS guard: pass, no decision: the user answers this tool (N-185)') printf '%s\\n' \"$out\" ;; *) printf '%s\\n' '{\"hookSpecificOutput\": {\"hookEventName\": \"PermissionRequest\", \"decision\": {\"behavior\": \"deny\", \"message\": \"DevOS guard: DENIED, failing closed: the guard could not decide this permission request (it did not run, it failed, it printed nothing, or its answer was not a PermissionRequest decision). What to do instead: do not pursue the effect another way; record the denial and report the guard fault (plan/Installation_Working_Order.md section 10).\"}}}' ;; esac",
            "timeout": 600,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__claude-code-remote__create_session|mcp__claude-code-remote__create_trigger",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/record_owned_id.py\" || true"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent_hooks.py\" PostToolUse || true",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/reread_after_compact.py\" || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent_hooks.py\" SessionStart || true",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^(producer|researcher|prober|checker|test-designer)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent_hooks.py\" SubagentStart || true",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(producer|researcher|prober|checker|test-designer)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent_hooks.py\" SubagentStop || true",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
