{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*|Artifact|ArtifactData|ArtifactComments|DesignSync",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/tool_allowlist.py\"; rc=$?; [ $rc -eq 0 ] || exit 2"
          }
        ]
      }
    ]
  }
}
