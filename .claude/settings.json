{
  "model": "claude-opus-5-5",
  "effortLevel": "xhigh",
  "ultracode": true,
  "env": {
    "CLAUDE_CODE_EFFORT_LEVEL": "xhigh"
  },
  "permissions": {
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/tool_allowlist.py\"; rc=$?; [ $rc -eq 0 ] || exit 2"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/tool_allowlist.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__claude-code-remote__create_session|mcp__claude-code-remote__create_trigger|mcp__claude-code-remote__send_later",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/record_owned_id.py\" || true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/boot_map\" || true"
          }
        ]
      }
    ]
  }
}
